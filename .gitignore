# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Internal docs (not required for deploy)
/docs/

# Client image staging library (local uploads — not deployed)
/image resources/

# Raw video uploads (optimize before committing the active MP4)
public/videos/**/sources/

# Local-only media archives (retired assets + raw sources — never commit / never deploy)
public/**/archive/

# Client briefs / copy decks (local reference only)
Bloodline_*.docx
Bloodline_*.pdf
*.docx

# Finder / iCloud duplicate copies ("filename 2.ext")
**/*[[:space:]]2.*

# Content pipeline scripts & mappings (outputs live in src/; keep catalog generator for prebuild)
/scripts/*
!/scripts/generate-gallery-catalog.ts

# Asset upload guides (internal ops notes under public/)
public/images/**/README.md
public/images/**/UPLOAD.md
