AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
RESEND_API_KEY=
OUTSCRAPER_API_KEY=
SENTRY_AUTH_TOKEN=
# Set in Vercel Production. Used by POST /api/revalidate to refresh gallery + review caches.
REVALIDATE_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SITE_ENV=local
# Vercel Preview / local only: append ?region=bali|bangkok|phuket|global to force a studio site.
# This override is disabled on VPS/production (hostname mapping only).
# Hostname → region mapping (comma-separated, no spaces). Unknown hosts fall back to `global`.
# Set these on Vercel for every custom domain; defaults only include bloodlinetattoo.* + *.localhost.
REGION_HOSTS_GLOBAL=localhost,bloodlinetattoo.com,www.bloodlinetattoo.com,bloodline-tatoo.vercel.app
REGION_HOSTS_BANGKOK=bangkok.localhost,bloodlinetattoobangkok.com,www.bloodlinetattoobangkok.com
REGION_HOSTS_BALI=bali.localhost,bloodlinetattoobali.com,www.bloodlinetattoobali.com
REGION_HOSTS_PHUKET=phuket.localhost,bloodlinetattoophuket.com,www.bloodlinetattoophuket.com
# Example — add your apex + subdomains to the lists above (or duplicate keys in Vercel):
# REGION_HOSTS_GLOBAL=prashanchandrapalan.com,www.prashanchandrapalan.com
# REGION_HOSTS_BALI=bali.prashanchandrapalan.com
# REGION_HOSTS_BANGKOK=bangkok.prashanchandrapalan.com
# REGION_HOSTS_PHUKET=phuket.prashanchandrapalan.com
